{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spring-creation-studio-website",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "springcreationstudio.com",
      "custom_domain": true
    },
    {
      "pattern": "www.springcreationstudio.com",
      "custom_domain": true
    }
  ]
}
